{
  "name": "SupplierQuote",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "moq": {
      "type": "number",
      "default": 1
    },
    "lead_time_days": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "communications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "meeting",
              "note"
            ]
          },
          "subject": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "by_user": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "supplier_id",
    "store_id",
    "product_name",
    "unit_cost"
  ]
}